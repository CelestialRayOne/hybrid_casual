{
  "name": "gem-dig",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gem dig block puzzle (working title TBD)",
  "engines": {
    "node": ">=24.5 <27"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "check:ip": "node scripts/check-banned-terms.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size && npm run check:ip"
  },
  "size-limit": [
    {
      "name": "JS (gzip)",
      "path": "dist/**/*.js",
      "limit": "600 kB"
    },
    {
      "name": "Whole first download (raw)",
      "path": "dist/**/*",
      "limit": "8 MB",
      "gzip": false,
      "brotli": false
    }
  ],
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "eslint": "10.15.0",
    "size-limit": "14.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
